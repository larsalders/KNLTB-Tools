{
  "manifest_version": 3,
  "name": "KNLTB Tools",
  "version": "2.4.0",
  "description": "Adds interactive elements to various KNLTB pages to allow for faster and more realistic rating calculations and visualizations.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://mijnknltb.toernooi.nl/*"
  ],
  "action": {
    "default_icon": "icon.png"
  },
  "content_scripts": [
    {
      "matches": ["*://mijnknltb.toernooi.nl/player-profile/*/Rating"],
      "js": [
        "shared/knltb-utils.js",
        "shared/ui-panel.js",
        "pages/player-profile.js",
        "pages/rating-tooltips.js",
        "lib/chart.min.js",
        "lib/chartjs-adapter-date-fns.bundle.min.js"
      ]
    },
    {
      "matches": ["*://mijnknltb.toernooi.nl/*"],
      "js": [
        "shared/knltb-utils.js",
        "shared/ui-panel.js",
        "pages/rating-tooltips.js",
        "pages/draw-state.js",
        "pages/draw-parser.js",
        "pages/draw-ui.js",
        "pages/draw-import.js",
        "pages/draw.js"
      ],
      "run_at": "document_idle"
    }
  ]
}